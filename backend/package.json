{
  "name": "Capita-backend",
  "version": "1.0.0",
  "description": "REST API for Capita -the AI financial assistant that treats the model as untrusted and enforces financial authority with deterministic policy.",
  "type": "module",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "seed": "node src/seed.js",
