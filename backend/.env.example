# Copy to backend/.env and fill in your keys. backend/.env is gitignored.
# The LLM only PROPOSES; deterministic policy decides. If no keys are set (or
# the providers are unreachable), the system falls back to a local heuristic
# proposer and still works — the decision layer never depends on the LLM.

# Primary proposer: Google Gemini (generativelanguage API key, passed as ?key=)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest

# Secondary proposer: Anthropic Claude
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-3-5-sonnet-20241022

# Optional
# PORT=4000
# AUTONOMOUS_LIMIT_INR=100000
# LLM_TIMEOUT_MS=10000
